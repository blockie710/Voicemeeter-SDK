// Voicemeeter Plugin Host - Windows Resource File

#include <windows.h>

// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VB-Audio Software"
            VALUE "FileDescription", "Voicemeeter Plugin Host"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VoicemeeterPluginHost"
            VALUE "LegalCopyright", "Copyright (C) 2025 VB-Audio Software"
            VALUE "OriginalFilename", "VoicemeeterPluginHost.exe"
            VALUE "ProductName", "Voicemeeter Plugin Host"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application icon - commented out since we don't have an icon file
// IDI_ICON1 ICON "icon.ico"